INITIAL_OWNER_EMAIL="your-email@example.com"
# Paystack secret key (starts with sk_) — Settings > API Keys & Webhooks in
# the Paystack dashboard. Required for GitPush Pro checkout and for
# verifying webhook signatures.
PAYSTACK_SECRET_KEY=""
# Plan code (starts with PLN_) for the recurring GitPush Pro plan — create
# it under Payments > Plans in the Paystack dashboard, then paste its code
# here. Checkout is disabled until this is set.
PAYSTACK_PRO_PLAN_CODE=""
# Sentry DSN — from Settings > Client Keys (DSN) on your Sentry project. The
# VITE_ copy is exposed to the browser bundle (this is expected; DSNs are
# public identifiers, not secrets). Leave both blank to disable Sentry
# entirely — the SDK no-ops without a DSN rather than erroring.
SENTRY_DSN=""
VITE_SENTRY_DSN=""
# Environment label shown on events in Sentry, e.g. "production", "staging".
SENTRY_ENVIRONMENT="development"
VITE_SENTRY_ENVIRONMENT="development"
# Optional — only needed for automatic source map upload during `vite build`.
# Create a token at Settings > Auth Tokens in Sentry with the project:releases
# scope. Without these three, builds still succeed; stack traces just show
# minified code instead of real file/line info.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SUPABASE_PROJECT_ID="znctzcjhxqurfgxbknvu"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_TbsByzk5-2SNDZGRX4wQ1Q_bjHq8LOo"
SUPABASE_URL="https://znctzcjhxqurfgxbknvu.supabase.co"
